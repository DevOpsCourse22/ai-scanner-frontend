# Keep the build context small and reproducible: dependencies are installed
# inside the image from package-lock.json, and dist/ is built there too.
node_modules
dist
*.log
.env
.env.*

# Jenkins build leftovers in the workspace: the image tars, scan reports,
# test results and the deployment-repo clone. Kept out so the Push stage's
# rebuild sees exactly the same context as the Build stage (same image).
*.tar
trivy-*.txt
test-results/
deploy/
